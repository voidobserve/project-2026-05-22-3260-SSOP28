 105          void aip3368h_module_init(void)
 106          {
 107   1          // memset(aip3368h_display_buff, 0xF0, sizeof(aip3368h_display_buff));
 108   1          // 显示驱动芯片有记忆功能（数据锁存），每次上电应该清空显存
 109   1          memset(aip3368h_display_buff, 0x00, sizeof(aip3368h_display_buff));
 110   1      
 111   1          // DCK
 112   1          P1_MD0 &= ~GPIO_P11_MODE_SEL(0x03);
 113   1          P1_MD0 |= GPIO_P11_MODE_SEL(0x01);
 114   1          FOUT_S11 = GPIO_FOUT_AF_FUNC;
 115   1          // DIO
C51 COMPILER V9.60.7.0   AIP3368                                                           06/03/2026 18:44:12 PAGE 3   

 116   1          P1_MD0 &= ~GPIO_P12_MODE_SEL(0x03);
 117   1          P1_MD0 |= GPIO_P12_MODE_SEL(0x01);
 118   1          FOUT_S12 = GPIO_FOUT_AF_FUNC;
 119   1          // LAT
 120   1          P0_MD0 &= ~GPIO_P03_MODE_SEL(0x03);
 121   1          P0_MD0 |= GPIO_P03_MODE_SEL(0x01);
 122   1          FOUT_S03 = GPIO_FOUT_AF_FUNC;
 123   1          // PDM
 124   1          // USER_TO_DO PDM 需要改成 PWM 驱动
 125   1          P0_MD0 &= ~GPIO_P00_MODE_SEL(0x03);
 126   1          P0_MD0 |= GPIO_P00_MODE_SEL(0x01);
 127   1          FOUT_S00 = GPIO_FOUT_STMR0_PWMOUT; // 选择stmr0_pwmout
 128   1      
 129   1      #define STMR0_PEROID_VAL (SYSCLK / 1 / 1000 - 1) // 周期值=系统时钟/分频/频率 - 1
 130   1          // STIMER0配置1kHz PWM
 131   1          STMR0_PSC = STMR_PRESCALE_VAL(0x00);                        // 不分频
 132   1          STMR0_PRH = STMR_PRD_VAL_H((STMR0_PEROID_VAL >> 8) & 0xFF); // 周期高八位寄存器
 133   1          STMR0_PRL = STMR_PRD_VAL_L((STMR0_PEROID_VAL >> 0) & 0xFF); // 周期低八位寄存器
 134   1          STMR0_CMPAH = STMR_CMPA_VAL_H(((0) >> 8) & 0xFF);           // 比较值
 135   1          STMR0_CMPAL = STMR_CMPA_VAL_L(((0) >> 0) & 0xFF);           // 比较值
 136   1      
 137   1          STMR_PWMVALA = STMR_0_PWMVALA(0x00); // PWM输出值
 138   1          STMR_PWMEN |= STMR_0_PWM_EN(0x1);    // PWM输出使能
 139   1          STMR_CNTMD |= STMR_0_CNT_MODE(0x1);  // 选择连续计数模式
 140   1          STMR_LOADEN |= STMR_0_LOAD_EN(0x1);  // 自动装载使能
 141   1          STMR_CNTCLR |= STMR_0_CNT_CLR(0x1);  // 计数清零
 142   1          STMR_CNTEN |= STMR_0_CNT_EN(0x1);    // 计数使能
 143   1      
 144   1          DIO = 0;
 145   1          DCK = 0;
 146   1          LAT = 0;
 147   1          // PDM = 0;
 148   1          aip3368h_module_send_data_to_all_dev(aip3368h_display_buff, AIP3368H_DEV_NUM);
 149   1      }
