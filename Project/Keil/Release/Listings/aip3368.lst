 151          void aip3368h_module_set_brightness(u8 brightness)
 152          {
 153   1          // STMR_PWMVALA = STMR_0_PWMVALA(brightness);
 154   1      
 155   1          u16 channel_duty = (u32)brightness * STMR0_PEROID_VAL / 100;
 156   1      
 157   1          STMR0_CMPAH = STMR_CMPA_VAL_H(((channel_duty) >> 8) & 0xFF); // 比较值
 158   1          STMR0_CMPAL = STMR_CMPA_VAL_L(((channel_duty) >> 0) & 0xFF); // 比较值
 159   1          STMR_LOADEN |= STMR_0_LOAD_EN(0x1);                          // 自动装载使能
 160   1      }
