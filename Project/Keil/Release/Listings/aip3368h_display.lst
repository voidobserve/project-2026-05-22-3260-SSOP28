              /**
               * @brief 测试背光灯刻度条
               *
               */
              void aip3368h_display_test_back_light_scale_bar(void)
              {
                  static u16 cnt = 0;
                  static u8 level = 0;
              
                  cnt++;
                  if (cnt < 500)
                  {
                      return;
                  }
                  else
                  {
                      cnt = 0;
                  }
              
                  aip3368h_display_back_light_scale_bar(level);
              
                  level++;
                  if (level >= 34)
                  {
                      level = 0;
                  }
              }
              
