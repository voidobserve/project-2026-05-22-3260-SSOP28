 664   2              __aip3368h_display_speed_seg__(0, SEG_INDEX_B, 1);
 665   2              __aip3368h_display_speed_seg__(0, SEG_INDEX_C, 1);
 666   2          }
 667   1      
 668   1          for (i = 1; i < 3; i++) // 第 1 ~ 2 位数码管
 669   1          {
