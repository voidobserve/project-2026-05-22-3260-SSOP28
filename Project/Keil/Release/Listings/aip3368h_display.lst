 623           */
 624          void aip3368h_display_speed(u8 speed)
 625          {
 626   1          u8 i;
 627   1          u8 j;
 628   1          // u8 segment_code;
 629   1          // 传参的有效数据位：
 630   1          u8 valid_bits = 0;
 631   1          u8 tmp = 0;
 632   1      
 633   1          // 默认先清空时速的显示
 634   1          // 时速 第 0 位：
