 638   1          for (i = 1; i < 3; i++)
 639   1          {
 640   2              for (j = 0; j < 7; j++) // 遍历 A ~ G 段
 641   2              {
 642   3                  aip3368h_display_buff[speed_segment_map[i][j].buff_index] &=
 643   3                      ~(0x01 << speed_segment_map[i][j].bit_offset);
 644   3              }
 645   2          }
 646   1        
 647   1          // 判断 speed 的有效数据位
 648   1          tmp = speed;
 649   1          while (1)
 650   1          {
 651   2              valid_bits++; // 刚进入，默认至少有1位有效数据
 652   2              tmp /= 10;
 653   2              if (tmp == 0)
 654   2              {
 655   3                  break;
 656   3              }
 657   2          }
 658   1      
 659   1          // printf("valid_bits == %u\n", (u16)valid_bits);
 660   1      
 661   1          if (speed >= 100)
