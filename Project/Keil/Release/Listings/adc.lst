 116          void adc_channel_switch_by_isr(void)
 117          {
 118   1          switch (adc_channel_status)
 119   1          {
 120   2          case ADC_CHANNEL_STATUS_NONE:
 121   2          case ADC_CHANNEL_STATUS_SEL_PHOTOSENSITIVE_END:
 122   2              adc_channel_set(ADC_CHANNEL_FUEL);
 123   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_FUEL_BEGIN;
 124   2              break;
 125   2          case ADC_CHANNEL_STATUS_SEL_FUEL_BEGIN:
 126   2              ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 127   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_FUEL_END;
 128   2              break;
 129   2          case ADC_CHANNEL_STATUS_SEL_FUEL_END:
 130   2              adc_channel_set(ADC_CHANNEL_PHOTOSENSITIVE);
 131   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_PHOTOSENSITIVE_BEGIN;
 132   2              break;
 133   2          case ADC_CHANNEL_STATUS_SEL_PHOTOSENSITIVE_BEGIN:
 134   2              ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 135   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_PHOTOSENSITIVE_END;
 136   2              break;
 137   2          default:
 138   2              break;
 139   2          }
